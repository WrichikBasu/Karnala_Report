\RequirePackage{setspace}

% -----------------------------------------------------------------
% CUSTOMISE DATE FORMAT IN \today
% -----------------------------------------------------------------
\DTMnewdatestyle{mydateformat}{%
	%	
	\renewcommand{\DTMdisplaydate}[4]{%
		\nth{\DTMtwodigits{##3}}\nobreakspace % DD
		\DTMmonthname{##2}\nobreakspace  %   MMM
		\number##1                       %   YYYY
	}%
	\renewcommand{\DTMDisplaydate}{\DTMdisplaydate}%
}

\DTMsetdatestyle{mydateformat}

% ----------------------------------------------------------------

\setlength{\parindent}{0pt}
\newgeometry{top=1.5cm,
	bottom=2cm,
	left=1.5cm,
	right=1.5cm
}

\renewcommand{\arraystretch}{1.5}

\newenvironment{tabmini}[1][2mm]{\begin{minipage}{\linewidth}\raggedright\vspace{#1}\def\spacing{#1}}{\vspace{\spacing}\end{minipage}}

\fancyhf{}  % https://tex.stackexchange.com/a/13897/200495
\renewcommand{\headrulewidth}{0pt}

\fancypagestyle{nofooter}{%
	\fancyfoot{}%
}

\fancypagestyle{frontmatter}{%
	\fancyfoot{}%
	\pagenumbering{roman}
	\fancyfoot[C]{\thepage}
}

\fancypagestyle{regular}{%
	\fancyfoot{}%
	\pagenumbering{arabic}%
	\fancyfoot[C]{\footnotesize Page \thepage\ of \pageref*{LastPage}}
}

\pagestyle{regular}

